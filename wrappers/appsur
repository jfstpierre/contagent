#!/bin/bash
# appsur - Apptainer wrapper for Cursor agent
# Provides sandboxing by limiting file access to a workspace folder.

set -e

# Configuration
SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/context.sh
source "${SCRIPT_DIR}/lib/context.sh"
SIF_IMAGE="${CONTAGENT_DIR:-${HOME}/.contagent}/apptainer.sif"

# Get absolute path of workspace (current directory)
WORKSPACE="$(pwd)"
VARIANT_DIR="${WORKSPACE}/.contagent/apptainer"
CONTAINER_HOME="${VARIANT_DIR}/home"

# Migrate from old per-tool directory to shared apptainer directory.
if [ ! -d "${CONTAINER_HOME}" ]; then
    for _old in applaude appbash appopen appsur; do
        if [ -d "${WORKSPACE}/.contagent/${_old}/home" ]; then
            mkdir -p "${VARIANT_DIR}"
            mv "${WORKSPACE}/.contagent/${_old}/home" "${CONTAINER_HOME}"
            break
        fi
    done
fi

# Host Cursor directories (for credentials/settings)
HOST_CURSOR_AUTH="${HOME}/.config/cursor/auth.json"
HOST_CURSOR_CONFIG="${HOME}/.cursor/cli-config.json"

# Check if host auth.json exists
if [ ! -f "${HOST_CURSOR_AUTH}" ]; then
  echo "Error: ${HOST_CURSOR_AUTH} does not exist."
  echo "Please run 'cursor login' first to set up your Cursor credentials."
  exit 1
fi

# Check if host cli-config.json exists
if [ ! -f "${HOST_CURSOR_CONFIG}" ]; then
  echo "Error: ${HOST_CURSOR_CONFIG} does not exist."
  echo "Please run 'cursor login' first to set up your Cursor configuration."
  exit 1
fi

if [ ! -f "${SIF_IMAGE}" ]; then
  echo "Error: SIF not found: ${SIF_IMAGE}"
  echo "Run 'contagent build' first to build the container image."
  exit 1
fi

# Persistent per-workspace home (not sensitive).
mkdir -p "${CONTAINER_HOME}/.config/cursor" "${CONTAINER_HOME}/.cursor"

# Credentials live in ~/.contagent (private, never in the shareable workspace).
# Copied fresh every launch so token refreshes from previous sessions are picked up.
CRED_DIR="${CONTAGENT_DIR:-${HOME}/.contagent}/cursor/creds"
mkdir -p "${CRED_DIR}"
cp "${HOST_CURSOR_AUTH}" "${CRED_DIR}/auth.json"
chmod 600 "${CRED_DIR}/auth.json"
cp "${HOST_CURSOR_CONFIG}" "${CRED_DIR}/cli-config.json"
chmod 600 "${CRED_DIR}/cli-config.json"

# Empty stubs ensure the bind targets exist as files (not directories).
cp "${CRED_DIR}/auth.json" "${CONTAINER_HOME}/.config/cursor/auth.json"
cp "${CRED_DIR}/cli-config.json" "${CONTAINER_HOME}/.cursor/cli-config.json"

trap 'contagent_ssh_agent_cleanup' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Load the Apptainer module recorded by contagent, if any
load_apptainer_module

# Parse .contagent/mounts for extra bind mounts
EXTRA_BIND_ARGS=()
init_mounts_file "${WORKSPACE}"
parse_mounts_apptainer "${WORKSPACE}" EXTRA_BIND_ARGS
forward_ssh_agent_apptainer "${WORKSPACE}" EXTRA_BIND_ARGS

# Generate container context file and install Cursor rules
generate_context_file "${WORKSPACE}" "apptainer"
install_cursor_rules "${WORKSPACE}" "${WORKSPACE}/.contagent/context.md"

# Propagate PATH with cursor-agent's install dir prepended.
# Also include $HOME/.local/bin (= CONTAINER_HOME/.local/bin) so startup
# checks don't warn about ~/.local/bin not being in PATH.
export APPTAINERENV_PATH="/root/.local/bin:${CONTAINER_HOME}/.local/bin:${PATH}"

# Run cursor-agent with:
# --home: per-workspace persistent home
# --bind: credential overlay (fresh from host), workspace read-write, plus extra mounts
# --workdir: start in /workspace
# Pass through all arguments to cursor-agent
apptainer exec \
  --home "${CONTAINER_HOME}" \
  --bind "${CRED_DIR}/auth.json:${CONTAINER_HOME}/.config/cursor/auth.json" \
  --bind "${CRED_DIR}/cli-config.json:${CONTAINER_HOME}/.cursor/cli-config.json" \
  --bind "${WORKSPACE}:/workspace" \
  "${EXTRA_BIND_ARGS[@]}" \
  --workdir /workspace \
  "${SIF_IMAGE}" \
  cursor-agent "$@"
