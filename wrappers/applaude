#!/bin/bash
# Applaude - Apptainer wrapper for Claude Code
# Provides sandboxing by limiting file access to a workspace folder

set -e

# Configuration
SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/context.sh
source "${SCRIPT_DIR}/lib/context.sh"
SIF_IMAGE="${CONTAGENT_DIR:-${HOME}/.contagent}/apptainer.sif"

# Get absolute path of workspace (current directory)
WORKSPACE="$(pwd)"
VARIANT_DIR="${WORKSPACE}/.contagent/apptainer"
CONTAINER_HOME="${VARIANT_DIR}/home"

# Migrate from old per-tool directory to shared apptainer directory.
if [ ! -d "${CONTAINER_HOME}" ]; then
    for _old in applaude appbash appopen appsur; do
        if [ -d "${WORKSPACE}/.contagent/${_old}/home" ]; then
            mkdir -p "${VARIANT_DIR}"
            mv "${WORKSPACE}/.contagent/${_old}/home" "${CONTAINER_HOME}"
            break
        fi
    done
fi

# Host Claude directory (for credentials/settings)
HOST_CLAUDE_DIR="${HOME}/.claude"
HOST_CLAUDE_JSON="${HOME}/.claude.json"

# Check if host ~/.claude exists
if [ ! -d "${HOST_CLAUDE_DIR}" ]; then
    echo "Error: ${HOST_CLAUDE_DIR} does not exist."
    echo "Please run 'claude login' first to set up your Claude credentials."
    exit 1
fi

# Check if host ~/.claude.json exists
if [ ! -f "${HOST_CLAUDE_JSON}" ]; then
    echo "Error: ${HOST_CLAUDE_JSON} does not exist."
    echo "Please run 'claude login' first to set up your Claude configuration."
    exit 1
fi

# Persistent per-workspace home (Claude history, project memory, etc. — not sensitive).
mkdir -p "${CONTAINER_HOME}/.claude"
mkdir -p "${CONTAINER_HOME}/.ssh"
inject_ssh_config_apptainer "${WORKSPACE}" "${CONTAINER_HOME}"

# Credentials live in ~/.contagent (private, never in the shareable workspace).
# Copied fresh every launch so token refreshes from previous sessions are picked up.
CRED_DIR="${CONTAGENT_DIR:-${HOME}/.contagent}/claude/creds"
mkdir -p "${CRED_DIR}"
cp "${HOST_CLAUDE_DIR}/.credentials.json" "${CRED_DIR}/.credentials.json"
chmod 600 "${CRED_DIR}/.credentials.json"
cp "${HOST_CLAUDE_JSON}" "${CRED_DIR}/.claude.json"
chmod 600 "${CRED_DIR}/.claude.json"

# Empty stubs ensure the bind targets exist as files (not directories).
: > "${CONTAINER_HOME}/.claude/.credentials.json"
: > "${CONTAINER_HOME}/.claude.json"

trap 'contagent_ssh_agent_cleanup' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ ! -f "${SIF_IMAGE}" ]; then
    echo "Error: SIF not found: ${SIF_IMAGE}"
    echo "Run 'contagent' first to build the container image."
    exit 1
fi

# Load the Apptainer module recorded by contagent, if any
load_apptainer_module

# Parse .contagent/mounts for extra bind mounts
EXTRA_BIND_ARGS=()
init_mounts_file "${WORKSPACE}"
parse_mounts_apptainer "${WORKSPACE}" EXTRA_BIND_ARGS
forward_ssh_agent_apptainer "${WORKSPACE}" EXTRA_BIND_ARGS

# Generate container context file and install Claude skills
generate_context_file "${WORKSPACE}" "apptainer"
install_claude_skills "${CONTAINER_HOME}"

# Ensure claude's install dir is on PATH inside the container.
# Also include $HOME/.local/bin (= CONTAINER_HOME/.local/bin) so claude's
# startup check doesn't warn about ~/.local/bin not being in PATH.
export APPTAINERENV_PATH="/root/.local/bin:${CONTAINER_HOME}/.local/bin:${PATH}"

# Run the container with:
# --home: per-workspace persistent home
# --bind: credential overlay (fresh from host), workspace read-write, plus extra mounts
# --workdir: start in /workspace
# Pass through all arguments to claude
apptainer run \
    --home "${CONTAINER_HOME}" \
    --bind "${CRED_DIR}/.credentials.json:${CONTAINER_HOME}/.claude/.credentials.json" \
    --bind "${CRED_DIR}/.claude.json:${CONTAINER_HOME}/.claude.json" \
    --bind "${WORKSPACE}:/workspace" \
    "${EXTRA_BIND_ARGS[@]}" \
    --workdir /workspace \
    "${SIF_IMAGE}" \
    --append-system-prompt-file /workspace/.contagent/context.md \
    "$@"
