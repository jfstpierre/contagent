#!/bin/bash
# appopen-cvmfs - Apptainer wrapper for OpenCode agent (DRAC/Alliance cluster variant)
# Provides sandboxing by limiting file access to a workspace folder.
# Python and other software come from the CVMFS-mounted module stack,
# not from the SIF image. Tracks loaded modules in .appopen/modules.

set -e

# Configuration
SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/context.sh
source "${SCRIPT_DIR}/lib/context.sh"
SIF_IMAGE="${CONTAGENT_DIR:-${HOME}/.contagent}/apptainer-cvmfs.sif"

# Get absolute path of workspace (current directory)
WORKSPACE="$(pwd)"
VARIANT_DIR="${WORKSPACE}/.contagent/apptainer"
CONTAINER_HOME="${VARIANT_DIR}/home"

# Migrate from old per-tool directory to shared apptainer directory.
if [ ! -d "${CONTAINER_HOME}" ]; then
    for _old in applaude appbash appopen appsur; do
        if [ -d "${WORKSPACE}/.contagent/${_old}/home" ]; then
            mkdir -p "${VARIANT_DIR}"
            mv "${WORKSPACE}/.contagent/${_old}/home" "${CONTAINER_HOME}"
            break
        fi
    done
fi

# Migrate old modules file to shared location.
if [ ! -f "${VARIANT_DIR}/modules" ]; then
    for _old in applaude appopen appsur appbash; do
        if [ -f "${WORKSPACE}/.contagent/${_old}/modules" ]; then
            mkdir -p "${VARIANT_DIR}"
            mv "${WORKSPACE}/.contagent/${_old}/modules" "${VARIANT_DIR}/modules"
            break
        fi
    done
fi

# Host OpenCode directories (for credentials/settings)
HOST_OPENCODE_AUTH="${HOME}/.local/share/opencode/auth.json"
HOST_OPENCODE_CONFIG="${HOME}/.config/opencode"

# Check if host auth.json exists
if [ ! -f "${HOST_OPENCODE_AUTH}" ]; then
  echo "Error: ${HOST_OPENCODE_AUTH} does not exist."
  echo "Please configure OpenCode first (e.g. run 'opencode' and set up your API keys)."
  exit 1
fi

if [ ! -f "${SIF_IMAGE}" ]; then
  echo "Error: SIF not found: ${SIF_IMAGE}"
  echo "Run 'contagent' first to build the container image."
  exit 1
fi

# Persistent per-workspace home (not sensitive).
mkdir -p "${CONTAINER_HOME}/.local/share/opencode" \
         "${CONTAINER_HOME}/.local/state/opencode" \
         "${CONTAINER_HOME}/.config/opencode"

# model.json (recently-used model preference) is not sensitive; seed workspace-local copy.
# prompt-history.jsonl is intentionally left workspace-local.
HOST_OPENCODE_MODEL="${HOME}/.local/state/opencode/model.json"
if [ -f "${HOST_OPENCODE_MODEL}" ] && \
   [ ! -f "${CONTAINER_HOME}/.local/state/opencode/model.json" ]; then
  cp "${HOST_OPENCODE_MODEL}" "${CONTAINER_HOME}/.local/state/opencode/model.json"
fi

# Credentials live in ~/.contagent (private, never in the shareable workspace).
# Copied fresh every launch so token refreshes from previous sessions are picked up.
CRED_DIR="${CONTAGENT_DIR:-${HOME}/.contagent}/opencode/creds"
mkdir -p "${CRED_DIR}"
cp "${HOST_OPENCODE_AUTH}" "${CRED_DIR}/auth.json"
chmod 600 "${CRED_DIR}/auth.json"
if [ -f "${HOST_OPENCODE_CONFIG}/opencode.json" ]; then
  cp "${HOST_OPENCODE_CONFIG}/opencode.json" "${CRED_DIR}/opencode.json"
fi

# Empty stubs ensure the bind targets exist as files (not directories).
cp "${CRED_DIR}/auth.json" "${CONTAINER_HOME}/.local/share/opencode/auth.json"

# Inject context.md into the OpenCode config
generate_context_file "${WORKSPACE}" "apptainer-cvmfs" "${VARIANT_DIR}/modules"
generate_opencode_config "${CRED_DIR}" "${WORKSPACE}"

# Stub for opencode.json config if it was generated into CRED_DIR
if [ -f "${CRED_DIR}/opencode.json" ]; then
  cp "${CRED_DIR}/opencode.json" "${CONTAINER_HOME}/.config/opencode/opencode.json"
fi

trap 'contagent_ssh_agent_cleanup' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Reconcile loaded modules against saved list
reconcile_cvmfs_modules "${VARIANT_DIR}/modules"

# Load the Apptainer module recorded by contagent, if any
load_apptainer_module

# Build bind args: always bind workspace; bind /cvmfs if present on host.
BIND_ARGS=("--bind" "${WORKSPACE}:/workspace")
[ -d "/cvmfs" ] && BIND_ARGS+=("--bind" "/cvmfs:/cvmfs")

# Parse .contagent/mounts for extra bind mounts
init_mounts_file "${WORKSPACE}"
parse_mounts_apptainer "${WORKSPACE}" BIND_ARGS
forward_ssh_agent_apptainer "${WORKSPACE}" BIND_ARGS

# Propagate PATH with opencode's install dir prepended.
# Also include $HOME/.local/bin (= CONTAINER_HOME/.local/bin) so startup
# checks don't warn about ~/.local/bin not being in PATH.
# All other module-set env vars (LD_LIBRARY_PATH, PYTHONPATH, EBROOT*, etc.)
# flow into the container automatically via Apptainer's default host-env inheritance.
export APPTAINERENV_PATH="/root/.opencode/bin:/root/.local/bin:${CONTAINER_HOME}/.local/bin:${PATH}"

# Run opencode with:
# --home: per-workspace persistent home
# --bind: credential overlay (fresh from host), workspace read-write, plus /cvmfs if available, plus .contagent/mounts
# --workdir: start in /workspace
# Pass through all arguments to opencode
CRED_BIND_ARGS=("--bind" "${CRED_DIR}/auth.json:${CONTAINER_HOME}/.local/share/opencode/auth.json")
if [ -f "${CRED_DIR}/opencode.json" ]; then
  CRED_BIND_ARGS+=("--bind" "${CRED_DIR}/opencode.json:${CONTAINER_HOME}/.config/opencode/opencode.json")
fi

apptainer exec \
  --home "${CONTAINER_HOME}" \
  "${CRED_BIND_ARGS[@]}" \
  "${BIND_ARGS[@]}" \
  --workdir /workspace \
  "${SIF_IMAGE}" \
  opencode "$@"
